<?xml version="1.0" encoding="UTF-8"?>

<?import com.plovdev.pornviewer.ui.components.PluginSelectorCombobox?>
<?import com.plovdev.pornviewer.ui.components.PornTabPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<BorderPane prefWidth="1000.0" prefHeight="600.0"
            xmlns="http://javafx.com"
            xmlns:fx="http://javafx.com"
            fx:controller="com.plovdev.pornviewer.ui.controllers.MainLayoutController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 8 12 8 12;">
            <PluginSelectorCombobox fx:id="pluginSelector"/>
            <Button text="⋮" styleClass="plugin-settings" onAction="#handlePluginSettings"/>
        </HBox>
    </top>

    <center>
        <PornTabPane fx:id="pornTabPane" BorderPane.alignment="CENTER"/>
    </center>
</BorderPane>