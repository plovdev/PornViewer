<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.plovdev.pornviewer.ui.controllers.MainMenuController"
            fx:id="rootAnchor" prefWidth="1000.0" prefHeight="600.0">

    <BorderPane fx:id="root" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
        <top>
            <VBox fx:id="vBox" spacing="10">
                <padding>
                    <Insets bottom="30.0"/>
                </padding>
                <HBox>
                    <TextField fx:id="field" promptText="Поиск..." prefHeight="35.0" styleClass="porn-search"/>
                    <Label fx:id="clear" text="✕" visible="false" styleClass="clear-search"/>
                    <Region fx:id="space" prefWidth="60.0"/>
                    <Button fx:id="deepSearch" text="Глубокий поиск" visible="false"
                            styleClass="deep-search-button" translateY="5.0"/>
                </HBox>
                <HBox spacing="30.0">
                    <VBox spacing="10.0">
                        <CheckBox fx:id="box1" text="Названия" styleClass="porn-check-box"/>
                        <CheckBox fx:id="box3" text="Описания" styleClass="porn-check-box"/>
                    </VBox>
                    <VBox spacing="10.0">
                        <CheckBox fx:id="box4" text="Дата" styleClass="porn-check-box"/>
                        <CheckBox fx:id="box6" text="Теги" styleClass="porn-check-box"/>
                    </VBox>
                    <Region fx:id="r1" HBox.hgrow="ALWAYS"/>
                    <!-- TrianglePaginationBlock создаётся в контроллере, т.к. это кастомный контрол -->
                    <HBox fx:id="paginationBlockHolder" translateX="38.0" translateY="35.0"/>
                    <Button fx:id="categ" text="K" styleClass="categories"/>
                </HBox>
            </VBox>
        </top>
        <center>
            <ScrollPane fx:id="pornScroll" fitToHeight="true" fitToWidth="true" styleClass="porn-scroll">
                <content>
                    <FlowPane fx:id="pane" hgap="50.0" vgap="50.0"
                              alignment="TOP_LEFT" styleClass="main-pane-content">
                        <padding>
                            <Insets top="10.0" right="10.0" bottom="50.0" left="10.0"/>
                        </padding>
                    </FlowPane>
                </content>
            </ScrollPane>
        </center>
    </BorderPane>

    <!-- CategoryManager — кастомный контрол, добавляется в контроллере -->
    <AnchorPane fx:id="managerHolder" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                AnchorPane.rightAnchor="0.0"/>

</AnchorPane>