<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<fx:root type="javafx.scene.layout.StackPane"
         fx:id="rootPane"
         maxWidth="400.0"
         onMouseEntered="#onMouseEntered"
         onMouseExited="#onMouseExited"
         xmlns="http://javafx.com"
         xmlns:fx="http://fxml.com">

    <children>
        <VBox spacing="10.0" styleClass="trailer">
            <children>
                <ImageView fx:id="previewImage"
                           fitHeight="250.0"
                           fitWidth="420.0"
                           preserveRatio="true"
                           styleClass="video-preview"/>

                <HBox spacing="10.0" styleClass="title-box">
                    <children>
                        <Hyperlink fx:id="titleLink"
                                   maxWidth="350.0"
                                   onAction="#onTitleClick"
                                   styleClass="video-title"
                                   wrapText="true"/>
                        <Label fx:id="ratingLabel"/>
                    </children>
                </HBox>
            </children>
        </VBox>

        <HBox fx:id="infoOverlay"
              styleClass="video-hover"
              visible="false"
              StackPane.alignment="BOTTOM_CENTER">
            <StackPane.margin>
                <Insets bottom="50.0"/>
            </StackPane.margin>
            <children>
                <VBox HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                    </padding>
                    <children>
                        <HBox HBox.hgrow="ALWAYS">
                            <children>
                                <Region HBox.hgrow="ALWAYS"/>
                                <VBox spacing="10.0">
                                    <children>
                                        <Label onMouseClicked="#onFavoriteClick" translateX="3.5">
                                            <graphic>
                                                <SVGPath fx:id="favPath"
                                                         content="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                                                         stroke="WHITE"
                                                         strokeWidth="2.0"/>
                                            </graphic>
                                        </Label>
                                        <ImageView fx:id="downloadIcon"
                                                   fitHeight="30.0"
                                                   fitWidth="30.0"
                                                   preserveRatio="true"/>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <Region VBox.vgrow="ALWAYS"/>

                        <HBox>
                            <children>
                                <Label fx:id="viewsLabel" styleClass="marker"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="durationLabel" styleClass="marker"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</fx:root>