<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com"
            xmlns:fx="http://javafx.com"
            fx:controller="com.plovdev.pornviewer.controllers.MainMenuController"
            prefHeight="600.0" prefWidth="1000.0"><!-- Текстовое поле в центре -->
    <Label layoutX="200.0" layoutY="150.0" text="Привет, JavaFX!">
        <font>
            <Font size="24.0"/>
        </font>
    </Label>

    <!-- Кнопка под текстом -->
    <Button fx:id="myButton" layoutX="250.0" layoutY="220.0"
            onAction="#handle" text="Нажми меня"/>

</AnchorPane>
